# Copy to .env and fill in real values.

# Connection string from your Supabase or Neon project.
# Supabase: Project Settings -> Database -> Connection string (URI, "Session" mode is fine for dev)
# Neon: shown right on the project dashboard
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Where the FastAPI AI service (Milestone 3) is running
FASTAPI_URL="http://localhost:8000"

# Any long random string. Example generation: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

PORT=5000
